---
import type { Hero } from '@/data/types';

interface Props {
  hero: Hero;
}

const { hero } = Astro.props;
---

<section class="hero">
  <div class="container hero__inner">
    <p class="hero__badge"><span class="dot"></span>{hero.eyebrow}</p>
    <h1>
      {hero.title}<span class="hero__highlight">{hero.highlight}</span>
    </h1>
    <p class="hero__subtitle">{hero.subtitle}</p>
    <div class="hero__actions">
      <a class="btn btn--primary" href={hero.primary.href}>{hero.primary.label}</a>
      <a class="btn btn--ghost" href={hero.secondary.href}>{hero.secondary.label}</a>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    isolation: isolate;
    padding-block: clamp(4.5rem, 12vw, 8rem);
    text-align: center;
  }
  .hero::before {
    content: '';
    position: absolute;
    inset: -40% -10% auto;
    height: 120%;
    background:
      radial-gradient(40% 50% at 30% 40%, color-mix(in srgb, var(--accent) 22%, transparent), transparent 70%),
      radial-gradient(35% 45% at 72% 30%, color-mix(in srgb, #06b6d4 18%, transparent), transparent 70%);
    filter: blur(20px);
    pointer-events: none;
    z-index: -1;
  }
  .hero__inner {
    max-width: 820px;
  }
  .hero__badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 1.5rem;
    padding: 0.375rem 0.875rem;
    border: 1px solid var(--border);
    border-radius: 999px;
    background: var(--surface);
    color: var(--muted);
    font-size: 0.875rem;
    font-weight: 500;
  }
  .dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--success);
    box-shadow: 0 0 0 4px color-mix(in srgb, var(--success) 20%, transparent);
  }
  h1 {
    font-size: clamp(2.25rem, 6.5vw, 4rem);
    font-weight: 800;
    letter-spacing: -0.02em;
  }
  .hero__highlight {
    background: linear-gradient(90deg, var(--accent), #06b6d4);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .hero__subtitle {
    max-width: 640px;
    margin: 1.25rem auto 2.25rem;
    color: var(--muted);
    font-size: clamp(1.0625rem, 2vw, 1.1875rem);
  }
  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75rem;
  }
</style>
