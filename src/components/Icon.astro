---
import type { Feature } from '@/data/types';

interface Props {
  name: Feature['icon'] | 'check' | 'logo';
  size?: number;
}

const { name, size = 24 } = Astro.props;

const paths: Record<Props['name'], string> = {
  bolt: 'M13 2 4 14h7l-1 8 9-12h-7l1-8z',
  shield: 'M12 3 4 6v6c0 4.5 3.4 8.4 8 9 4.6-.6 8-4.5 8-9V6l-8-3zm-3 9 2 2 4-4',
  chart: 'M4 20V10m6 10V4m6 16v-7m4 7H2',
  plug: 'M9 7V3m6 4V3M7 7h10v4a5 5 0 0 1-10 0V7zm5 9v5',
  users:
    'M16 20v-1.5A3.5 3.5 0 0 0 12.5 15h-5A3.5 3.5 0 0 0 4 18.5V20M10 11a3 3 0 1 0 0-6 3 3 0 0 0 0 6zm10 9v-1.5a3.5 3.5 0 0 0-2.5-3.35M15.5 5.15a3 3 0 0 1 0 5.7',
  globe:
    'M12 21a9 9 0 1 0 0-18 9 9 0 0 0 0 18zM3 12h18M12 3c2.5 2.5 3.8 5.5 3.8 9s-1.3 6.5-3.8 9c-2.5-2.5-3.8-5.5-3.8-9S9.5 5.5 12 3z',
  check: 'm5 12 4.5 4.5L19 7',
  logo: 'M12 3 3 20h4.5L12 11l4.5 9H21L12 3z',
};
---

<svg
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
>
  <path d={paths[name]} />
</svg>
