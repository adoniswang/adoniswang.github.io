---
import { site } from '@/config/site';
import Icon from './Icon.astro';
---

<header class="header">
  <div class="container header__inner">
    <a class="brand" href="/" aria-label={`${site.name} 首頁`}>
      <span class="brand__mark"><Icon name="logo" size={18} /></span>
      {site.name}
    </a>

    <nav class="nav" aria-label="主要導覽">
      <ul>
        {site.nav.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
      </ul>
    </nav>

    <a class="btn btn--primary header__cta" href={site.cta.href}>{site.cta.label}</a>

    <details class="menu">
      <summary aria-label="開啟選單">
        <span></span><span></span><span></span>
      </summary>
      <nav class="menu__panel" aria-label="行動版導覽">
        {site.nav.map((item) => <a href={item.href}>{item.label}</a>)}
        <a class="btn btn--primary" href={site.cta.href}>{site.cta.label}</a>
      </nav>
    </details>
  </div>
</header>

<script>
  // 行動版選單：點擊連結後自動收合（無 JS 時選單仍可正常開關）
  const menu = document.querySelector<HTMLDetailsElement>('.menu');
  menu?.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => (menu.open = false)));
</script>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 50;
    border-bottom: 1px solid var(--border);
    background: color-mix(in srgb, var(--bg) 85%, transparent);
    backdrop-filter: saturate(1.8) blur(12px);
  }
  .header__inner {
    display: flex;
    align-items: center;
    gap: 2rem;
    height: var(--header-h);
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--text);
    font-size: 1.125rem;
    font-weight: 700;
  }
  .brand:hover {
    text-decoration: none;
  }
  .brand__mark {
    display: grid;
    place-items: center;
    width: 30px;
    height: 30px;
    border-radius: 8px;
    background: var(--accent);
    color: var(--accent-contrast);
  }
  .nav {
    margin-right: auto;
  }
  .nav ul {
    display: flex;
    gap: 1.75rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .nav a {
    color: var(--muted);
    font-size: 0.9375rem;
    font-weight: 500;
  }
  .nav a:hover {
    color: var(--text);
    text-decoration: none;
  }
  .header__cta {
    min-height: 38px;
    padding-block: 0.5rem;
    font-size: 0.9375rem;
  }

  .menu {
    display: none;
    position: relative;
    margin-left: auto;
  }
  .menu summary {
    display: grid;
    gap: 5px;
    padding: 10px;
    cursor: pointer;
    list-style: none;
  }
  .menu summary::-webkit-details-marker {
    display: none;
  }
  .menu summary span {
    display: block;
    width: 20px;
    height: 2px;
    border-radius: 2px;
    background: var(--text);
    transition: transform 0.2s, opacity 0.2s;
  }
  .menu[open] summary span:nth-child(1) {
    transform: translateY(7px) rotate(45deg);
  }
  .menu[open] summary span:nth-child(2) {
    opacity: 0;
  }
  .menu[open] summary span:nth-child(3) {
    transform: translateY(-7px) rotate(-45deg);
  }
  .menu__panel {
    position: absolute;
    top: calc(100% + 10px);
    right: 0;
    display: grid;
    gap: 0.25rem;
    min-width: 220px;
    padding: 0.75rem;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface);
    box-shadow: var(--shadow);
  }
  .menu__panel a:not(.btn) {
    padding: 0.5rem 0.75rem;
    border-radius: var(--radius-sm);
    color: var(--text);
  }
  .menu__panel a:not(.btn):hover {
    background: var(--bg-soft);
    text-decoration: none;
  }
  .menu__panel .btn {
    margin-top: 0.5rem;
  }

  @media (max-width: 820px) {
    .nav,
    .header__cta {
      display: none;
    }
    .menu {
      display: block;
    }
  }
</style>
